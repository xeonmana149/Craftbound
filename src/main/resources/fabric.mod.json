			"craftbound.Craftbound"
		],
		"client": [
			"craftbound.client.CraftboundClient"
		]
	},
	"mixins": [
		"craftbound.mixins.json",
		{
			"config": "craftbound.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
