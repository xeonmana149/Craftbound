{
	"schemaVersion": 1,
	"id": "craftbound",
	"version": "${version}",
	"name": "Craftbound",
	"description": "A collectible card game inside Minecraft: build decks from mobs, blocks, tools and potions, then duel friends, the AI, or brave the roguelike Trials.",
	"authors": [
		"ZeElectron"
	],
	"contact": {
		"homepage": "https://github.com/xeonmana149/Craftbound",
		"sources": "https://github.com/xeonmana149/Craftbound",
		"issues": "https://github.com/xeonmana149/Craftbound/issues"
	},
	"license": "All-Rights-Reserved",
	"icon": "assets/craftbound/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"craftbound.Craftbound"
		],
		"client": [
			"craftbound.client.CraftboundClient"
		]
	},
	"mixins": [
		"craftbound.mixins.json",
		{
			"config": "craftbound.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}